# OpenRouter API Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-sonnet-4

# Google Search Console
GSC_CREDENTIALS_FILE=credentials/gsc_credentials.json
GSC_TOKEN_FILE=credentials/gsc_token.json

# Google Analytics
GA_CREDENTIALS_FILE=credentials/ga_credentials.json
GA_PROPERTY_ID=your_ga4_property_id_here

# Crawler Settings
MAX_PAGES=500
CRAWL_DELAY=1.0
MAX_CONCURRENT_REQUESTS=5
USER_AGENT=PromptGen Bot/1.0

# Prompt Extraction
TOP_PROMPTS_COUNT=500
MIN_PROMPT_QUALITY_SCORE=0.7

# Factcheck Settings
FACTCHECK_CONFIDENCE_THRESHOLD=0.8

# Cache Settings
CACHE_DIR=.cache
CACHE_TTL=86400

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/prompt_gen.log
